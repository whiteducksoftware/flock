# Foundry project endpoint - auto-injected in hosted containers.
# Only set manually when running locally.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment name - must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Upper bound for generated tokens (sent as max_completion_tokens).
MAX_COMPLETION_TOKENS=4000

# Concurrent workflows per replica; further requests get rate_limit_exceeded.
MAX_ACTIVE_WORKFLOWS=8

# Application Insights - auto-injected in hosted containers.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Local runs only:
# FLOCK_SAMPLE_OFFLINE=1        deterministic engines, no model needed
# FLOCK_FOUNDRY_LOCAL_DEV=1     accept requests without the gateway user header
